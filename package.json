{
  "name": "labdownloader",
  "version": "1.0.2",
  "description": "LabDownloader - Modern, elegant media and document downloader for Windows and Web",
  "main": "dist-electron/main/index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:backend": "python -m services.downloader.main --port 52174 --token devtoken1234567890abcdef",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:web": "vite build --mode web",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder --win",
    "test:backend": "pytest tests/ -v",
    "test": "npm run test:backend"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
